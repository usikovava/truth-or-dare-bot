import asyncio
import random
import json
from aiogram import Bot, Dispatcher, types
from aiogram.filters import Command
from aiogram.types import Message, ChatPermissions

# === НАСТРОЙКИ ===
TOKEN = "8808347564:AAGAnw-yTCJu5h96d7vQ-8Z5aJIowaYSasI"          # <-- Вставь токен от BotFather
CHANCE = 0.01                      # 1% шанс
DATA_FILE = "points.json"          # Файл для сохранения очков

# === ЗАГРУЗКА/СОХРАНЕНИЕ ОЧКОВ ===
def load_points():
    try:
        with open(DATA_FILE, "r") as f:
            return json.load(f)
    except:
        return {}

def save_points(points):
    with open(DATA_FILE, "w") as f:
        json.dump(points, f)

points = load_points()

# === БОТ ===
bot = Bot(token=TOKEN)
dp = Dispatcher()

# === КОМАНДЫ ===

# /points — показать свои очки
@dp.message(Command("points"))
async def cmd_points(message: Message):
    user_id = str(message.from_user.id)
    user_points = points.get(user_id, 0)
    name = message.from_user.first_name or "User"
    await message.answer(f"🎯 {name}, у тебя {user_points} очков!")

# /delpoints <число> — удалить очки (только для админов)
@dp.message(Command("delpoints"))
async def cmd_delpoints(message: Message):
    # Проверяем, что это ответ на сообщение
    if not message.reply_to_message:
        await message.answer("❌ Ответь на сообщение пользователя, которому нужно удалить очки!")
        return
    
    # Проверяем, что команда от админа
    chat_id = message.chat.id
    user_id = message.from_user.id
    
    # Получаем список админов чата
    chat_admins = await bot.get_chat_administrators(chat_id)
    admin_ids = [admin.user.id for admin in chat_admins]
    
    if user_id not in admin_ids:
        await message.answer("❌ Только администраторы чата могут удалять очки!")
        return
    
    # Проверяем, указано ли количество
    try:
        args = message.text.split()
        if len(args) < 2:
            await message.answer("❌ Укажи количество очков: /delpoints <число>")
            return
        amount = int(args[1])
    except:
        await message.answer("❌ Введи число: /delpoints <число>")
        return
    
    # Удаляем очки
    target_id = str(message.reply_to_message.from_user.id)
    target_name = message.reply_to_message.from_user.first_name or "User"
    
    current = points.get(target_id, 0)
    points[target_id] = max(0, current - amount)
    save_points(points)
    
    await message.answer(f"✅ У {target_name} удалено {amount} очков. Осталось: {points[target_id]}")

# === ГЛАВНЫЙ ОБРАБОТЧИК ===
@dp.message()
async def on_message(message: Message):
    # Пропускаем команды
    if message.text and message.text.startswith('/'):
        return
    
    # Пропускаем сообщения от бота
    if message.from_user.id == (await bot.me()).id:
        return
    
    # Проверяем 1% шанс
    if random.random() < CHANCE:
        user_id = str(message.from_user.id)
        
        # Добавляем очко
        points[user_id] = points.get(user_id, 0) + 1
        save_points(points)
        
        print(f"Очко получено! User: {message.from_user.first_name}, Всего: {points[user_id]}")

# === ЗАПУСК ===
async def main():
    await dp.start_polling(bot)

if name == "main":
    asyncio.run(main())
